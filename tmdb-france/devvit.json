{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "tmdb-france",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {},
  "menu": {
    "items": [
      {
        "label": "[tmdb-france] New Post",
        "description": "Create a new tmdb-france post.",
        "location": "subreddit",
        "endpoint": "/internal/on/menu/new-post"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scheduler": {
    "tasks": {
      "publish-wallpaper": {
        "endpoint": "/internal/scheduler/publish-wallpaper",
        "cron": "0 0,3,5,8,10,13,15,18,20,22 * * *"
      },
      "initial-burst": {
        "endpoint": "/internal/scheduler/initial-burst",
        "cron": "*/45 * * * * *"
      }
    }
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "dev": {
    "subreddit": "tmdb_france_dev"
  },
  "permissions": {
    "media": true,
    "redis": true,
    "http": {
      "enable": true,
      "domains": [
        "raw.githubusercontent.com",
        "api.github.com"
      ]
    },
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_POST"
      ]
    }
  }
}
